# GradBot reads these environment variables. Nothing reads this file by
# itself: copy it to .env, fill in what you need, and load it into your shell
#   macOS/Linux:  set -a; . ./.env; set +a
#   PowerShell:   Get-Content .env | ? {$_ -match '^[A-Z]'} | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# Never commit .env. It is in .gitignore.
#
# REQUIRED means the commands named there stop with a clear message when it
# is missing. Everything else has a working default.

# ── Students: practice ────────────────────────────────────────────────

# OPTIONAL (grade run). Public samples repo: owner/repo on GitHub, a git
# URL, or an absolute path. Default: the public demo course.
GRADBOT_PUBLIC_REPO=nvmaditya/gradbot-course-samples

# OPTIONAL (grade run). Where practice clones are cached. Default: ~/.gradbot/local
# GRADBOT_LOCAL_DIR=

# ── Students: graded submit ───────────────────────────────────────────

# REQUIRED for grade login. Client id of the course's GitHub OAuth app.
# Your teacher gives you this. Login asks only for the read:user scope.
GRADBOT_CLIENT_ID=

# REQUIRED for grade submit. HTTPS endpoint of the course App. Your teacher
# gives you this. The submit zip and your login token are sent to it.
GRADBOT_SUBMIT_URL=

# OPTIONAL (grade login, grade submit). Where the login token is stored
# (mode 0600). Default: ~/.gradbot
# GRADBOT_CONFIG_DIR=

# ── Faculty ───────────────────────────────────────────────────────────

# REQUIRED for grade roster add and grade reset. A faculty GitHub token.
# Never put this on a student machine.
GRADBOT_APP_TOKEN=

# REQUIRED for grade reset. owner/repo that holds the one-submit slot refs.
GRADBOT_SUBMISSIONS_REPO=

# ── Everyone, rarely changed ──────────────────────────────────────────

# OPTIONAL. GitHub web and API URLs; change both for GitHub Enterprise Server.
# Defaults: https://github.com and https://api.github.com
# GRADBOT_GITHUB_URL=
# GRADBOT_GITHUB_API_URL=

# OPTIONAL. Any value turns off coloured output (https://no-color.org).
# NO_COLOR=1

# ── Tests only ────────────────────────────────────────────────────────

# OPTIONAL. Set to 1 to run the live smoke tests (pytest -m live) against
# the real GitHub. They also use GRADBOT_CLIENT_ID and GRADBOT_APP_TOKEN
# above when those are set, and skip the parts that need them otherwise.
# GRADBOT_LIVE=1
